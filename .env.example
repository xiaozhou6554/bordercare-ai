# Copy to .env and fill only when using an authorized provider.
APP_ENV=development
RESEARCH_DATA_MODE=live
DEFAULT_MARKETPLACE=US
DEFAULT_CURRENCY=USD
DEFAULT_PROFIT_TARGET=0.25
CACHE_DEFAULT_TTL=6
REDIS_URL=
DATABASE_URL=
MYSQL_DATABASE=research
MYSQL_USER=research
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
REDIS_PORT=6380
AUTH_ENABLED=false
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_ALLOW_SIGNUP=false
AUTH_TOKEN_TTL_SECONDS=28800
TASK_QUEUE_WORKERS=2
TASK_TIMEOUT_SECONDS=1800
TASK_QUEUE_ROLE=combined
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
SESSION_MEMORY_TTL_SECONDS=2592000
IDEMPOTENCY_TTL_SECONDS=86400
CRAWLER_DELAY_SECONDS=2.0
CRAWLER_MAX_RETRIES=3
CRAWLER_TIMEOUT_SECONDS=30

# OpenAI-compatible provider (DeepSeek, SiliconFlow, etc.)
LLM_PROVIDER=openai_compatible
DEEPSEEK_API_KEY=
# Optional generic key. DEEPSEEK_API_KEY takes precedence when both are set.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=30


# Optional official 1688 consignment-market search API.
# The API is documented as free and without seller authorization; App Key/Secret are still required.
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# Onebound credentials; Taobao keyword search is the default product-lead source.
# Enable 1688 only after the provider confirms account access.
ONEBOUND_API_KEY=
ONEBOUND_API_SECRET=
ONEBOUND_1688_ENABLED=false

# Or set LLM_PROVIDER=anthropic and provide ANTHROPIC_API_KEY and ANTHROPIC_MODEL_NAME.

# Docker Compose values. Use strong unique passwords and keep them out of Git.
API_PORT=8000
